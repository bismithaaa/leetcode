def is_anagram(s, t):
    dic = {}
    d = {}
    for i in s:
        if i in dic:
            dic[i] += 1
        else:
            dic[i] = 1
    for i in t:
        if i in d:
            d[i] += 1
        else:
            d[i] = 1
    if dic == d:
        return True
    else:
        return False
print(is_anagram("anagram", "nagaram"))